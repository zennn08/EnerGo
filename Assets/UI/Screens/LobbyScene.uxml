<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:eg="EnerGo.UI">
    <!-- LobbyScene root: the map background and one layer per screen; LobbyView shows the layer for the current state. -->
    <ui:Template name="Lobby" src="project://database/Assets/UI/Screens/Lobby.uxml" />
    <Style src="project://database/Assets/UI/Theme.uss" />
    <Style src="project://database/Assets/UI/Components.uss" />
    <Style src="project://database/Assets/UI/Screens/Layar.uss" />
    <ui:VisualElement name="akar" style="flex-grow: 1;">
        <eg:PetaLatar name="peta" />
        <ui:VisualElement name="lapis-lobby" class="eg-lapis"><ui:Instance template="Lobby" class="eg-lapis" /></ui:VisualElement>
        <ui:VisualElement name="lapis-sheet" class="eg-lapis" picking-mode="Ignore" />
        <ui:VisualElement name="lapis-panduan" class="eg-lapis" picking-mode="Ignore" />
        <ui:VisualElement name="lapis-splash" class="eg-lapis" picking-mode="Ignore" />
        <ui:VisualElement name="lapis-transisi" class="eg-lapis" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
