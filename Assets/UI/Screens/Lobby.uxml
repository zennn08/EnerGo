<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Lobby (docs/design-system/components/LayarAwal/preview.html, middle frame). Values are set by LobbyView. -->
    <ui:Template name="Tile" src="project://database/Assets/UI/Screens/Tile.uxml" />
    <Style src="project://database/Assets/UI/Theme.uss" />
    <Style src="project://database/Assets/UI/Components.uss" />
    <Style src="project://database/Assets/UI/Screens/Layar.uss" />
    <ui:VisualElement name="lobby" class="eg-layar eg-aman">
        <ui:VisualElement class="eg-baris" style="justify-content: space-between;">
            <ui:VisualElement class="eg-pil eg-pil--angka">
                <ui:VisualElement class="eg-pil__ikon" style="background-image: url(&quot;project://database/Assets/UI/Icons/petir.svg&quot;);" />
                <ui:Label name="total-unit" text="0 unit" />
            </ui:VisualElement>
            <ui:VisualElement style="width: 44px; height: 44px; background-image: url(&quot;project://database/Assets/UI/Logo/energo-mark.png&quot;);" />
        </ui:VisualElement>
        <ui:Label name="judul" class="eg-judul-layar lobby__judul" text="ENER&lt;color=#a6481a&gt;GO!&lt;/color&gt;" />
        <ui:VisualElement class="eg-kartu lobby__koleksi">
            <ui:Label class="eg-selotip" text="KOLEKSI ENERGIMU" />
            <ui:VisualElement class="lobby__tiles">
                <ui:Instance template="Tile" name="tile-sun" />
                <ui:Instance template="Tile" name="tile-coal" />
                <ui:Instance template="Tile" name="tile-gold" />
                <ui:Instance template="Tile" name="tile-oil" />
                <ui:Instance template="Tile" name="tile-uranium" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="eg-tengah">
            <ui:VisualElement class="eg-pil eg-pil--laut lobby__mode">
                <ui:VisualElement class="eg-pil__ikon" style="width: 20px; height: 20px; background-image: url(&quot;project://database/Assets/UI/Icons/kamera.svg&quot;);" />
                <ui:Label name="mode-kamera" text="Mode kamera: Sensor 360" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="btn-berburu" class="eg-btn eg-btn--utama eg-btn--besar eg-btn--penuh">
            <ui:VisualElement class="eg-btn__ikon" style="background-image: url(&quot;project://database/Assets/UI/Icons/radar.svg&quot;);" />
            <ui:Label text="BERBURU!" />
        </ui:Button>
        <ui:VisualElement class="lobby__dock">
            <ui:VisualElement class="eg-bulat">
                <ui:Button name="btn-desa" class="eg-bulat__tombol">
                    <ui:VisualElement class="eg-bulat__ikon" style="background-image: url(&quot;project://database/Assets/UI/Icons/rumah.svg&quot;);" />
                    <ui:VisualElement name="desa-tanda" class="lobby__tanda" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="Desa" />
            </ui:VisualElement>
            <ui:VisualElement class="eg-bulat eg-bulat--oker">
                <ui:Button name="btn-panduan" class="eg-bulat__tombol"><ui:VisualElement class="eg-bulat__ikon" style="background-image: url(&quot;project://database/Assets/UI/Icons/buku.svg&quot;);" /></ui:Button>
                <ui:Label text="Panduan" />
            </ui:VisualElement>
            <ui:VisualElement class="eg-bulat eg-bulat--laut">
                <ui:Button name="btn-latihan" class="eg-bulat__tombol"><ui:VisualElement class="eg-bulat__ikon" style="background-image: url(&quot;project://database/Assets/UI/Icons/target.svg&quot;);" /></ui:Button>
                <ui:Label text="Latihan" />
            </ui:VisualElement>
            <ui:VisualElement class="eg-bulat">
                <ui:Button name="btn-pengaturan" class="eg-bulat__tombol"><ui:VisualElement class="eg-bulat__ikon" style="background-image: url(&quot;project://database/Assets/UI/Icons/gir.svg&quot;);" /></ui:Button>
                <ui:Label text="Pengaturan" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
