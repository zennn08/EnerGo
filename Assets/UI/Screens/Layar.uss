/* Screen layouts for LobbyScene, positions from docs/design-system/components/LayarAwal and LayarSheet previews (480 x 800). */
.eg-lapis { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.eg-layar { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: column; padding: 28px 16px 24px 16px; }

/* Lobby */
.lobby__judul { font-size: 60px; margin: 12px 0 22px 0; }
.lobby__koleksi { padding: 28px 8px 16px 8px; margin-bottom: 12px; }
.lobby__tiles { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.lobby__tiles .eg-tile { margin: 7px 5px; }
.lobby__mode { min-height: 32px; font-size: 13px; align-self: center; margin-bottom: 12px; }
.lobby__dock { flex-direction: row; justify-content: space-around; margin-top: auto; }

/* Sheets: paper card rising from the bottom over the shared curtain (LayarSheet preview) */
.eg-sheet {
    position: absolute; left: 12px; right: 12px; bottom: -16px; padding: 36px 20px 40px 20px;
    border-radius: 24px 24px 0 0; border-bottom-width: 0;
    translate: 0 100%; transition-property: translate; transition-duration: 0.25s; transition-timing-function: ease-out;
}
.eg-sheet.is-terbuka { translate: 0 0; }
.sheet--latihan { padding: 36px 16px 40px 16px; }
.sheet__sub { -unity-text-align: middle-center; font-size: 16px; margin-bottom: 18px; }
.sheet__grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.sheet__grid .eg-tile { margin: 8px 4px; }
.sheet__mulai { margin-top: 28px; }
.sheet__tombol { margin-top: 20px; }
.sheet__tombol .eg-btn { margin-top: 7px; margin-bottom: 7px; }
.sheet__tombol #btn-reset { font-size: 18px; }
.sheet__reset-bar { margin: -4px 8px 4px 8px; }
.sheet__ikon-suara { width: 32px; height: 32px; background-image: url("project://database/Assets/UI/Icons/suara.svg"); }
.sheet__persen { width: 48px; -unity-text-align: middle-right; }
.sheet__notice { -unity-text-align: middle-center; margin-top: 6px; }

/* Guide card, read mode (LayarSheet preview, third frame) */
.panduan__layar { justify-content: center; }
.panduan__kartu { padding: 34px 20px 20px 20px; }
.panduan__garis { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.panduan__langkah { -unity-text-align: middle-center; font-size: 14px; color: var(--tinta-pudar); }
.panduan__bingkai {
    height: 170px; margin: 12px 0; align-items: center; justify-content: center;
    background-color: var(--kertas-300); border-width: var(--garis-tinta); border-color: var(--tinta); border-radius: 12px;
}
.panduan__ilustrasi { width: 96px; height: 96px; }
.panduan__isi { margin: 6px 0 14px 0; }
.panduan__titik { margin-bottom: 16px; }
.panduan__titik-kini { width: 24px; height: 10px; border-radius: 5px; background-color: var(--tinta); margin: 0 4px; }
.panduan__titik-lain { width: 10px; height: 10px; border-radius: 5px; background-color: var(--kertas-300); border-width: var(--garis-tinta); border-color: var(--tinta); margin: 0 4px; }
.panduan__utama { margin-left: var(--space-3); }

/* Splash */
.splash { align-items: center; justify-content: center; }
.splash__kartu { padding: 28px 28px 22px 28px; align-items: center; }
.splash__tanda { width: 128px; height: 128px; background-image: url("project://database/Assets/UI/Logo/energo-mark.svg"); }
.splash__wordmark { -unity-font-definition: var(--font-judul); font-size: 72px; letter-spacing: -2.16px; margin-top: 12px; color: var(--tinta); -unity-text-align: middle-center; }
.splash__tagline { font-size: 16px; color: var(--tinta-pudar); margin-top: 10px; -unity-text-align: middle-center; }
.splash__bawah { position: absolute; left: 56px; right: 56px; bottom: 64px; }
.splash__ajakan { margin-top: 18px; -unity-text-align: middle-center; }

/* Transisi */
.transisi { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--tinta); align-items: center; justify-content: center; }
.transisi__tanda { width: 120px; height: 120px; background-image: url("project://database/Assets/UI/Logo/energo-mark.svg"); margin-bottom: 24px; }
.transisi__teks { -unity-font-definition: var(--font-data-bold); font-size: 18px; color: var(--kertas-100); margin-bottom: 24px; }
.transisi__bar { width: 200px; border-color: var(--kertas-100); }
.transisi__isi { border-color: var(--kertas-100); }

/* Radar (LayarRadar, Radar, KartuTarget) */
.radar__atas { justify-content: space-between; margin-bottom: 8px; }
.radar__disk { flex-grow: 1; flex-shrink: 1; min-height: 160px; margin-bottom: 8px; }
.radar__huruf { position: absolute; width: 24px; height: 24px; -unity-text-align: middle-center; -unity-font-definition: var(--font-judul); font-size: 18px; color: var(--tinta); padding: 0; margin: 0; }
.radar__huruf--utara { color: var(--stempel); }
.radar__jarak { position: absolute; -unity-font-definition: var(--font-data); font-size: 12px; color: var(--tinta-pudar); padding: 0; margin: 0; }
.radar__node { position: absolute; align-items: center; justify-content: center; background-color: var(--kertas-100); border-width: 2px; border-color: var(--tinta); border-radius: 29px; }
.radar__node.is-dekat { border-width: 4px; border-color: var(--oranye); }
.radar__node.is-terpilih { border-width: 4px; border-color: var(--tinta); }
.radar__node.is-terkunci { opacity: 0.55; }
.radar__node-ikon { width: 70%; height: 70%; }
.radar__node-cahaya { position: absolute; left: -6px; top: -6px; right: -6px; bottom: -6px; border-radius: 40px; background-color: rgba(57, 255, 20, 0.28); }
.radar__info { flex-direction: column; align-items: flex-start; align-self: stretch; justify-content: center; min-height: 48px; padding: 4px 14px; border-radius: 20px; font-size: 13px; letter-spacing: 0; margin-bottom: 8px; }
.radar__info Label { padding: 0; margin: 0; white-space: normal; }
.radar__info--awas { color: var(--stempel); }
.radar__target { padding: 14px 16px 14px 16px; }
.radar__target-isi { margin-bottom: 10px; }
.radar__target-ikon { width: 56px; height: 56px; margin-right: 12px; }
.radar__panah { width: 40px; height: 40px; background-image: url("project://database/Assets/UI/Icons/panah.svg"); }
.radar__panah.is-terkunci { background-image: url("project://database/Assets/UI/Icons/gembok.svg"); }
.radar__kosong { -unity-text-align: middle-center; white-space: normal; padding: 18px 8px; }
.radar__lapis { align-items: center; justify-content: center; padding: 0 24px; }
.radar__dialog { width: 100%; max-width: 400px; padding: 40px 20px 18px 20px; }
.radar__dialog-teks { white-space: normal; -unity-text-align: middle-center; margin-bottom: 16px; }
.radar__dialog-btn { margin-top: 10px; }
.radar__pudar { opacity: 0.35; }

/* Capture frame (HudTangkap, PitaKompas) */
.tangkap__header { justify-content: space-between; margin-bottom: 8px; }
.tangkap__mode { font-size: 13px; }
.tangkap__mode-pil { align-self: center; min-height: 36px; font-size: 12px; }
.tangkap__riak { position: absolute; border-width: 3px; border-color: var(--oranye); }
.status { background-color: var(--kertas-100); border-width: var(--garis-tinta); border-bottom-width: 3px; border-color: var(--tinta); border-radius: var(--radius-md); padding: 8px 12px; margin-bottom: 8px; }
.status--gagal { background-color: var(--stempel-muda); }
.status__tag { -unity-font-definition: var(--font-data-bold); font-size: 13px; color: var(--kertas-100); padding: 2px 8px; margin: 0 8px 0 0; border-radius: 6px; flex-shrink: 0; }
.status__tag--AMAN { background-color: var(--hutan); }
.status__tag--AWAS { background-color: var(--oker); color: var(--tinta); }
.status__tag--GAGAL { background-color: var(--stempel); }
.status__tag--INFO { background-color: var(--laut); }
.status__teks { -unity-font-definition: var(--font-isi-bold); font-size: 14px; color: var(--tinta); white-space: normal; flex-shrink: 1; padding: 0; margin: 0; }
.status__sub { font-size: 13px; color: var(--tinta-pudar); margin: 4px 0 0 0; padding: 0; white-space: normal; }
.status__bar-baris { margin-top: 6px; }
.status__angka { width: 52px; font-size: 13px; -unity-text-align: middle-right; margin: 0; padding: 0; }
.eg-isi--hutan { background-color: var(--hutan); }
.eg-isi--oker { background-color: var(--oker); }
.pita { height: 52px; background-color: var(--kertas-100); border-width: var(--garis-tinta); border-color: var(--tinta); border-radius: var(--radius-sm); overflow: hidden; }
.pita__label { position: absolute; top: 3px; width: 32px; -unity-text-align: middle-center; -unity-font-definition: var(--font-data-bold); font-size: 13px; color: var(--tinta); margin: 0; padding: 0; }
.pita__label--utara { color: var(--stempel); }
.pita__tepi { position: absolute; top: 12px; -unity-font-definition: var(--font-data-bold); font-size: 14px; color: var(--oranye-tua); background-color: var(--kertas-200); padding: 2px 6px; margin: 0; }
.pita__mati { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-text-align: middle-center; -unity-font-definition: var(--font-data-bold); font-size: 13px; color: var(--tinta-pudar); margin: 0; }
.panduan__ingatkan { display: none; margin-bottom: 12px; align-items: center; }
.panduan__centang { width: 26px; height: 26px; margin-right: 10px; background-color: var(--kertas-200); border-width: var(--garis-tinta); border-color: var(--tinta); border-radius: 6px; }
.panduan__centang.is-nyala { background-color: var(--hutan); background-image: url("project://database/Assets/UI/Icons/centang.svg"); }
